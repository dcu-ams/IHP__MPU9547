set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {dout[7]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {iorq_n}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {m1_n}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {mreq_n}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {rd_n}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {wr_n}]
set_false_path\
    -from [get_ports {reset_n}]
###############################################################################
# Environment
###############################################################################
set_load -pin_load 0.8000 [get_ports {iorq_n}]
set_load -pin_load 0.8000 [get_ports {m1_n}]
set_load -pin_load 0.8000 [get_ports {mreq_n}]
set_load -pin_load 0.8000 [get_ports {rd_n}]
set_load -pin_load 0.8000 [get_ports {wr_n}]
set_load -pin_load 0.8000 [get_ports {A[9]}]
set_load -pin_load 0.8000 [get_ports {A[8]}]
set_load -pin_load 0.8000 [get_ports {A[7]}]
set_load -pin_load 0.8000 [get_ports {A[6]}]
set_load -pin_load 0.8000 [get_ports {A[5]}]
set_load -pin_load 0.8000 [get_ports {A[4]}]
set_load -pin_load 0.8000 [get_ports {A[3]}]
set_load -pin_load 0.8000 [get_ports {A[2]}]
set_load -pin_load 0.8000 [get_ports {A[1]}]
set_load -pin_load 0.8000 [get_ports {A[0]}]
set_load -pin_load 0.8000 [get_ports {c2p_en[7]}]
