###############################################################################
# Created by write_sdc
###############################################################################
current_design tv80s
###############################################################################
# Timing Constraints
###############################################################################
create_clock -name clk -period 50.0000 [get_ports {clk}]
set_clock_transition 0.1500 [get_clocks {clk}]
set_clock_uncertainty 0.2500 clk
set_propagated_clock [get_clocks {clk}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[0]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[0]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[1]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[1]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[2]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[2]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[3]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[3]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[4]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[4]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[5]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[5]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[6]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[6]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {di[7]}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {di[7]}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {int_n}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {int_n}]
set_input_delay 0.0000 -clock [get_clocks {clk}] -min -add_delay [get_ports {reset_n}]
set_input_delay 10.0000 -clock [get_clocks {clk}] -max -add_delay [get_ports {reset_n}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[0]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[1]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[2]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[3]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[4]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[5]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[6]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[7]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[8]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {A[9]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[0]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[1]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[2]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[3]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[4]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[5]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[6]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {c2p_en[7]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {dout[0]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {dout[1]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {dout[2]}]
set_output_delay 10.0000 -clock [get_clocks {clk}] -add_delay [get_ports {dout[3]}]
