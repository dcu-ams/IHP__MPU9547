set_load -pin_load 0.8000 [get_ports {dout[7]}]
set_load -pin_load 0.8000 [get_ports {dout[6]}]
set_load -pin_load 0.8000 [get_ports {dout[5]}]
set_load -pin_load 0.8000 [get_ports {dout[4]}]
set_load -pin_load 0.8000 [get_ports {dout[3]}]
set_load -pin_load 0.8000 [get_ports {dout[2]}]
set_load -pin_load 0.8000 [get_ports {dout[1]}]
set_load -pin_load 0.8000 [get_ports {dout[0]}]
set_timing_derate -early 0.9500
set_timing_derate -late 1.0500
###############################################################################
# Design Rules
###############################################################################
set_max_fanout 10.0000 [current_design]
